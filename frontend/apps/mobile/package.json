{
  "name": "@convai/mobile",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "build": "tsc --noEmit",
    "bundle": "expo export --platform ios --platform android --output-dir dist",
    "test": "jest"
  },
  "dependencies": {
    "@convai/core": "*",
    "@convai/tokens": "*",
    "@convai/ui": "*",
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "tailwindcss": "^4.3.4",
    "uniwind": "^1.13.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/src/__tests__/emptyModule.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
